# Copy this file to .env and fill in real values for local testing.
# .env is gitignored — never commit real credentials.
# In production these are set directly in Netlify's environment variables UI.

# The Google Sheet ID (the long id in its URL, between /d/ and /edit) — not secret.
GOOGLE_SHEET_ID=1Glc0J5u-9c346McropA9bfluCmLxmuwWxg7KZFDaOAE

# From the downloaded service-account JSON key file:
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# IN THIS FILE (.env): keep the surrounding double quotes and the literal \n
# sequences, exactly as the value appears in the raw JSON key file. dotenv needs
# the quotes to keep the value on one line.
#
# IN THE NETLIFY UI: paste the SAME value but WITHOUT the surrounding quotes.
# Netlify stores the field literally, so leading/trailing quote characters end up
# inside the key and OpenSSL rejects it with:
#   error:1E08010C:DECODER routines::unsupported
# That error means the key is malformed, not that the credentials are wrong.
# Either literal \n or real newlines work — only the quotes break it.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
